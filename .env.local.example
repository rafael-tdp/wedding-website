# ============================================
# GOOGLE GEMINI API (For automatic translation)
# ============================================
# Get key at: https://aistudio.google.com/app/apikey
# Used by script: scripts/translate-with-gemini.js
GOOGLE_API_KEY=

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public key (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service key (for scripts and protected actions)
# ⚠️ NEVER commit this key to GitHub - use only locally
SUPABASE_SERVICE_KEY=
